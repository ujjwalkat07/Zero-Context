# ==============================================================================
# Zero-Context Environment Configuration
# Copy this file to .env and fill in your credentials
# ==============================================================================

# Google Gemini API Key (for text-embedding-004, 768-dimensional vectors)
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# PostgreSQL Connection String with pgvector extension enabled
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zero_context
